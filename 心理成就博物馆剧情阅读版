            { "id": "chi_lai", "name": "迟来", "description": "你赶上了别人的所有结局，自己的开端却无人等候。", "type": "role", "hidden": false, "story": "你赶上了别人的所有结局，自己的开端却无人等候。\n\n你总是慢一步，错过了所有的开始。当你终于赶到时，故事已经落幕，人群已经散去，只留下一地狼藉和满身尘埃的你。", "reward": "获得被动：[ 迟钝 ]", "claimed": false },
            { "id": "du_jiao_meng", "name": "独角梦", "description": "你参与了别人所有美梦，醒来时却只有自己一人。", "type": "role", "hidden": false, "story": "你参与了别人所有美梦，醒来时却只有自己一人。\n\n你闯入了他人的梦境，却无法在自己的梦里停留。你是那个永远在别人故事里客串的演员，却永远无法成为自己剧本的主角。", "reward": "获得技能：[ 入梦 ]", "claimed": false },
            { "id": "wu_sheng_tan", "name": "无声叹", "description": "你安慰了别人所有不甘，自己的叹息却无人听见。", "type": "role", "hidden": false, "story": "你安慰了别人所有不甘，自己的叹息却无人听见。\n\n你听懂了所有的委屈，却没人听懂你的沉默。你像是一个情绪垃圾桶，吞噬了所有的负能量，直到自己再也装不下任何东西。", "reward": "获得Buff：[ 共情 ]", "claimed": false },
            { "id": "duan_xian_qin", "name": "断弦琴", "description": "你奏响了别人的乐章，自己的旋律却再无人听。", "type": "role", "hidden": false, "story": "你奏响了别人的乐章，自己的旋律却再无人听。\n\n你为他人伴奏，自己却永远无法独奏。你的手指在琴弦上飞舞，弹奏着别人的喜怒哀乐，却弹不出自己心中的那首歌。", "reward": "获得乐器：[ 断弦琴 ]", "claimed": false },
            { "id": "shou_ye_ren", "name": "守夜人", "description": "所谓的守夜，是在黎明到来前，先把自己燃成灰烬。", "type": "role", "hidden": false, "story": "所谓的守夜，是在黎明到来前，先把自己燃成灰烬。\n\n你守护着光明，自己却属于黑暗。你看着太阳升起，看着人们苏醒，然后像幽灵一样退回阴影里，等待下一个漫长的黑夜。", "reward": "获得称号：[ 守夜人 ]", "claimed": false },
            { "id": "shi_huang_zhe", "name": "拾荒者", "description": "你捡回别人丢弃的希望，却发现那不过是早已过期的谎言。", "type": "role", "hidden": false, "story": "你捡回别人丢弃的希望，却发现那不过是早已过期的谎言。\n\n你珍视他人的垃圾，却找不到自己的宝藏。你像一只流浪狗，在世界的角落里翻找，试图拼凑出一个不存在的未来。", "reward": "获得技能：[ 拾荒 ]", "claimed": false },
            { "id": "xin_shi", "name": "信使", "description": "你传递了千万次求救，最后才明白，收件人早已死去。", "type": "role", "hidden": false, "story": "你传递了千万次求救，最后才明白，收件人早已死去。\n\n你奔波于传递希望，却不知希望早已破灭。你看着手中那封永远无法送达的信，感到一阵荒谬的悲凉。", "reward": "获得称号：[ 悲剧信使 ]", "claimed": false },
            { "id": "chen_mo_de_zheng_ren", "name": "沉默的证人", "description": "你目睹了所有罪恶，却只能在黑暗里，为自己的沉默陪葬。", "type": "role", "hidden": false, "story": "你目睹了所有罪恶，却只能在黑暗里，为自己的沉默陪葬。\n\n你知道真相，却选择了闭嘴。你告诉自己这无关紧要，直到罪恶蔓延到你的脚下，你才发现，沉默也是一种共谋。", "reward": "获得道具：[ 沉默徽章 ]", "claimed": false },
            { "id": "gui_ling_zhe", "name": "归零者", "description": "你清空所有记忆，以为能重获新生，却发现世界早已为你归零。", "type": "role", "hidden": false, "story": "你清空所有记忆，以为能重获新生，却发现世界早已为你归零。\n\n你抹去了过去，却发现自己从未存在。你像一张被格式化的白纸，却发现这个世界根本不需要你写下任何字迹。", "reward": "获得结局：[ 归零 ]", "claimed": false }
        ];

        const typeMap = {
            'story': '剧情',
            'status': '心理',
            'philosophy': '哲学',
            'ending': '结局',
            'secret': '隐藏',
            'combat': '战斗',
            'exploration': '探索',
            'misc': '杂项',
            'role': '角色',
            'sin': '原罪',
            'meta': 'Meta',
            'personality': '人格',
            'phobia': '恐惧',
            'sanity': '理智'
        };

        const container = document.getElementById('achievements');
        const filterBtns = document.querySelectorAll('.filter-btn');

        // 阅读器元素
        const readerOverlay = document.getElementById('readerOverlay');
        const rTitle = document.getElementById('r-title');
        const rText = document.getElementById('r-text');
        const rReward = document.getElementById('r-reward');
        const rFooter = document.getElementById('r-footer');
        const rClaimBtn = document.getElementById('r-claimBtn');

        let currentId = null;
        let typeInterval = null;

        // 渲染函数
        function renderAchievements(filterType) {
            container.innerHTML = '';
            const filteredData = filterType === 'all'
                ? achievementsData
                : achievementsData.filter(item => item.type === filterType);

            filteredData.forEach((item, index) => {
                const card = document.createElement('div');
                let typeClass = 'type-default';
                if (['story', 'ending', 'secret', 'philosophy', 'status', 'role'].includes(item.type)) {
                    typeClass = `type-${item.type}`;
                }
                const hiddenClass = item.hidden ? 'card-hidden' : '';
                const hiddenIcon = item.hidden ? '<div class="hidden-icon">?</div>' : '';
                const delay = index * 0.05;

                card.className = `achievement-card ${typeClass} ${hiddenClass}`;
                card.style.animationDelay = `${delay}s`;

                card.onclick = () => openReader(item.id);

                card.innerHTML = `
                    ${hiddenIcon}
                    <div class="card-header">
                        <span class="achievement-tag">${typeMap[item.type] || item.type}</span>
                    </div>
                    <div>
                        <div class="achievement-name">${item.name}</div>
                        <div class="achievement-desc">${item.description}</div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        renderAchievements('all');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderAchievements(btn.dataset.filter);
            });
        });

        // --- 阅读器逻辑 ---
        function openReader(id) {
            const ach = achievementsData.find(a => a.id === id);
            if (!ach) return;

            currentId = id;
            rTitle.innerText = ach.name;
            rReward.innerText = ach.reward;

            // 重置状态
            rText.innerHTML = '';
            rFooter.classList.remove('show');
            rClaimBtn.disabled = false;
            rClaimBtn.innerText = "领取奖励";

            if (ach.claimed) {
                rClaimBtn.innerText = "已领取";
                rClaimBtn.disabled = true;
            }

            readerOverlay.classList.add('active');

            // 启动打字机效果
            startTypewriter(ach.story || ach.description);
        }

        function closeReader() {
            readerOverlay.classList.remove('active');
            if (typeInterval) clearInterval(typeInterval);
            currentId = null;
        }

        function startTypewriter(text) {
            // 清理旧的定时器
            if (typeInterval) clearInterval(typeInterval);

            let i = 0;
            // 将换行符转换为 <br>
            const formattedText = text.replace(/\n/g, '<br>');

            // 使用 cursor
            rText.innerHTML = '<span class="cursor"></span>';

            typeInterval = setInterval(() => {
                if (i < formattedText.length) {
                    // 插入字符到光标前
                    const currentHTML = rText.innerHTML;
                    const char = formattedText.charAt(i);

                    // 简单处理：如果是 <br>，直接插入；否则插入字符
                    if (formattedText.substr(i, 4) === '<br>') {
                        rText.innerHTML = currentHTML.replace('<span class="cursor"></span>', '<br><span class="cursor"></span>');
                        i += 4;
                    } else {
                        rText.innerHTML = currentHTML.replace('<span class="cursor"></span>', `${char}<span class="cursor"></span>`);
                        i++;
                    }

                    // 自动滚动到底部
                    const contentDiv = document.querySelector('.reader-content');
                    contentDiv.scrollTop = contentDiv.scrollHeight;
                } else {
                    clearInterval(typeInterval);
                    // 移除光标
                    rText.innerHTML = rText.innerHTML.replace('<span class="cursor"></span>', '');
                    // 显示底部奖励栏
                    rFooter.classList.add('show');
                }
            }, 50); // 打字速度
        }

        function claimReward() {
            if (currentId === null) return;
            const ach = achievementsData.find(a => a.id === currentId);
            if (ach && !ach.claimed) {
                ach.claimed = true;
                rClaimBtn.innerText = "领取成功！";
                rClaimBtn.disabled = true;

                setTimeout(() => {
                    alert(`成功获得：${ach.reward}`);
                    closeReader();
                }, 500);
            }
        }

        // 点击遮罩层关闭
        readerOverlay.addEventListener('click', (e) => {
            if (e.target === readerOverlay) closeReader();
        });

    </script>
